[Unit]
Description=Jabridge — Jabra headset manager daemon
Documentation=https://github.com/Watchdog0x/jabridge
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/env jabridge --daemon
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t
ReadWritePaths=-%h/.config/jabridge
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=char-hidraw rw

[Install]
WantedBy=default.target
